{
  "name": "geocalc",
  "productName": "GeoCalc Pro",
  "version": "2.0.0",
  "description": "GeoCalc Pro — geotechnical analysis (slope stability, seepage, stress/FEM) with a capability registry, project files, and an AI chat assistant.",
  "author": "GeoCalc",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --publish never",
    "dist": "electron-builder --mac dir"
  },
  "build": {
    "appId": "com.geocalc.desktop",
    "productName": "GeoCalc Pro",
    "directories": { "output": "dist" },
    "files": [
      "index.html",
      "styles.css",
      "js/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
